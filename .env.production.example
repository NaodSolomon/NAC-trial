# Docker Compose interpolation values. Copy this file to .env.production and
# pass it with: docker compose --env-file .env.production -f docker-compose.prod.yml ...
SITE_DOMAIN=www.example.org
API_DOMAIN=api.example.org
STATUS_DOMAIN=status.example.org
MEDIA_PUBLIC_ORIGIN=https://media.example.org
ACME_EMAIL=operations@example.org

# Optional deployment overrides
BACKEND_IMAGE=ghcr.io/your-org/nehemiah-backend:latest
FRONTEND_IMAGE=ghcr.io/your-org/nehemiah-frontend:latest
BACKUP_HOST_PATH=./backups
