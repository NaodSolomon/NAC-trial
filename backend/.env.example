# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/appdb
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=appdb

# API
API_HOST=0.0.0.0
API_PORT=8000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=use-a-different-32-character-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=nehemiah-api
JWT_AUDIENCE=nehemiah-admin
IP_HASH_SECRET=replace-with-another-32-character-secret

NODE_ENV=development
# Use a comma-separated list when more than one frontend origin is allowed.
FRONTEND_URL=http://localhost:3000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=uploads
MINIO_USE_SSL=false

# Mail
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@app.local

# Optional bootstrap administrator used only by `pnpm db:seed`
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
