# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/appdb
# Legacy fallback fields used only when DATABASE_URL is absent.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=appdb

# API
API_HOST=0.0.0.0
API_PORT=8000
# Keep local development single-process; use 2 on a multi-core deployment after load testing.
WEB_CONCURRENCY=1
REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_REQUESTS=100
HTTP_LOG_SUCCESS_SAMPLE_RATE=1
HTTP_SLOW_REQUEST_MS=750
SWAGGER_ENABLED=true
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=use-a-different-32-character-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=nehemiah-api
JWT_AUDIENCE=nehemiah-admin
IP_HASH_SECRET=replace-with-another-32-character-secret
INTERNAL_API_KEY=replace-with-a-private-32-character-job-key
# Automatic CMS publishing runs inside the API. PostgreSQL prevents duplicate multi-worker runs.
SCHEDULED_PUBLISHING_ENABLED=true
SCHEDULED_PUBLISHING_INTERVAL_MS=60000

# Local trial adapters. This combination never contacts a paid service.
STORAGE_DRIVER=minio
MAIL_DRIVER=mailpit
PAYMENT_DRIVER=fake
CACHE_DRIVER=redis
PAYMENTS_ENABLED=false
TRIAL_MODE=true

# Cloudflare R2 uses its S3 endpoint. These defaults target local MinIO.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=nehemiah-media
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/nehemiah-media
MEDIA_MAX_FILE_SIZE_BYTES=10485760

# Real PayPal remains disabled until PAYMENT_DRIVER=paypal, PAYMENTS_ENABLED=true,
# PAYPAL_ENABLED=true, and all sandbox or production credentials are configured.
PAYPAL_ENABLED=false
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:3000/donate/success
PAYPAL_CANCEL_URL=http://localhost:3000/donate/cancel

NODE_ENV=development
# Use a comma-separated list when more than one frontend origin is allowed.
FRONTEND_URL=http://localhost:3000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT_MS=250
REDIS_COMMAND_TIMEOUT_MS=250
REDIS_CIRCUIT_COOLDOWN_MS=5000

# MinIO container bootstrap
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Mail
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@app.local
MAIL_CONNECTION_TIMEOUT_MS=3000
MAIL_GREETING_TIMEOUT_MS=3000
MAIL_SOCKET_TIMEOUT_MS=10000
PASSWORD_RESET_TTL_MINUTES=20
PASSWORD_RESET_URL=http://localhost:3000/admin/reset-password
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_INTERVAL_MS=5000
OUTBOX_WORKER_BATCH_SIZE=10
OUTBOX_WORKER_MAX_ATTEMPTS=5
OUTBOX_WORKER_BACKOFF_MS=30000
OUTBOX_WORKER_LOCK_TIMEOUT_MS=300000

# Host-side endpoints used by the combined E2E security gate in docker-compose.test.yml.
TEST_MAIL_HOST=127.0.0.1
TEST_MAIL_PORT=1026
TEST_MAILPIT_API_URL=http://127.0.0.1:8026

# Optional bootstrap administrator used only by `pnpm db:seed`
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Local scheduled backups. BACKUP_HOST_PATH is supplied to Docker Compose from the host shell.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_VERIFY_DATABASE=appdb_restore_verify
BACKUP_VERIFY_BUCKET=nehemiah-media-restore-verify
