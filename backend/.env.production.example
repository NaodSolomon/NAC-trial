# Copy to backend/.env.production and replace every placeholder before deployment.
# NODE_ENV, TRIAL_MODE, SWAGGER_ENABLED, PAYMENTS_ENABLED, and public origins
# are enforced by docker-compose.prod.yml and cannot be weakened here.
DATABASE_URL=postgresql://nehemiah:REPLACE_DATABASE_PASSWORD@postgres:5432/nehemiah
DATABASE_USER=nehemiah
DATABASE_PASSWORD=REPLACE_DATABASE_PASSWORD
DATABASE_NAME=nehemiah
# PostgreSQL's official image consumes these names. Keep them equal to the
# DATABASE_* values above.
POSTGRES_USER=nehemiah
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
POSTGRES_DB=nehemiah

API_HOST=0.0.0.0
API_PORT=8000
WEB_CONCURRENCY=2
REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_REQUESTS=100
HTTP_LOG_SUCCESS_SAMPLE_RATE=0.01
HTTP_SLOW_REQUEST_MS=750

JWT_ACCESS_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
IP_HASH_SECRET=REPLACE_WITH_A_THIRD_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
INTERNAL_API_KEY=REPLACE_WITH_A_FOURTH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=nehemiah-api
JWT_AUDIENCE=nehemiah-admin

SCHEDULED_PUBLISHING_ENABLED=true
SCHEDULED_PUBLISHING_INTERVAL_MS=60000
RESOURCE_DOWNLOAD_LOG_CLEANUP_ENABLED=true
RESOURCE_DOWNLOAD_LOG_RETENTION_DAYS=365
RESOURCE_DOWNLOAD_LOG_CLEANUP_INTERVAL_MS=86400000

STORAGE_DRIVER=minio
STORAGE_ENDPOINT=https://storage.example.org
STORAGE_REGION=auto
STORAGE_BUCKET=nehemiah-media
STORAGE_ACCESS_KEY_ID=REPLACE_STORAGE_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=REPLACE_STORAGE_SECRET_KEY
MEDIA_MAX_FILE_SIZE_BYTES=10485760
STORAGE_DELETION_WORKER_ENABLED=true
STORAGE_DELETION_WORKER_INTERVAL_MS=5000
STORAGE_DELETION_WORKER_BATCH_SIZE=10
STORAGE_DELETION_WORKER_MAX_ATTEMPTS=5
STORAGE_DELETION_WORKER_BACKOFF_MS=30000
STORAGE_DELETION_WORKER_LOCK_TIMEOUT_MS=300000

MAIL_DRIVER=mailpit
MAIL_HOST=smtp.example.org
MAIL_PORT=587
MAIL_FROM=noreply@example.org
CONTACT_NOTIFICATION_EMAIL=contact@example.org
MAIL_CONNECTION_TIMEOUT_MS=3000
MAIL_GREETING_TIMEOUT_MS=3000
MAIL_SOCKET_TIMEOUT_MS=10000
PASSWORD_RESET_TTL_MINUTES=20
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_INTERVAL_MS=5000
OUTBOX_WORKER_BATCH_SIZE=10
OUTBOX_WORKER_MAX_ATTEMPTS=5
OUTBOX_WORKER_BACKOFF_MS=30000
OUTBOX_WORKER_LOCK_TIMEOUT_MS=300000

PAYMENT_DRIVER=fake
PAYPAL_ENABLED=false
CACHE_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT_MS=250
REDIS_COMMAND_TIMEOUT_MS=250
REDIS_CIRCUIT_COOLDOWN_MS=5000

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_VERIFY_DATABASE=nehemiah_restore_verify
BACKUP_VERIFY_BUCKET=nehemiah-media-restore-verify
