{
  "name": "backend",
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config test/e2e/jest-e2e.json",
    "test:integration": "jest --config test/integration/jest-integration.json --runInBand",
    "test:ci": "pnpm lint && pnpm test -- --runInBand && pnpm test:e2e -- --runInBand && pnpm test:integration && pnpm db:check && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node src/database/seeds/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/passport": "latest",
    "@nestjs/platform-fastify": "latest",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "bcrypt": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "drizzle-orm": "latest",
    "fastify": "latest",
    "passport": "latest",
    "passport-jwt": "latest",
    "pdfkit": "^0.19.1",
    "pg": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@nestjs/mapped-types": "latest",
    "@nestjs/testing": "latest",
    "@types/bcrypt": "latest",
    "@types/jest": "30.0.0",
    "@types/node": "latest",
    "@types/passport-jwt": "latest",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "latest",
    "@types/supertest": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "dotenv": "latest",
    "drizzle-kit": "latest",
    "eslint": "latest",
    "jest": "latest",
    "prettier": "^3.0.0",
    "supertest": "latest",
    "ts-jest": "latest",
    "ts-node": "latest",
    "typescript": "^5.0.0"
  }
}
