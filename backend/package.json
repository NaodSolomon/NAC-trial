{
  "name": "backend",
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config test/e2e/jest-e2e.json",
    "test:e2e:security": "jest --config test/e2e/jest-e2e.json --runInBand test/e2e/security-regression.e2e-spec.ts",
    "test:integration": "ts-node test/helpers/report-integration-environment.ts && jest --config test/integration/jest-integration.json --runInBand",
    "openapi:generate": "nest build && node dist/src/openapi/generate-openapi.js",
    "openapi:lint": "pnpm openapi:generate && redocly lint dist/openapi.json",
    "test:ci": "pnpm lint && pnpm test:coverage --runInBand && pnpm test:e2e --runInBand && pnpm test:integration && pnpm db:check && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "ts-node src/database/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node src/database/seeds/seed.ts",
    "db:seed:demo": "ts-node src/database/seeds/seed-demo.ts",
    "db:check:launch-content": "ts-node src/database/check-launch-content.ts",
    "db:seed:e2e": "ts-node src/database/seeds/seed-e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@fastify/compress": "^9.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/passport": "latest",
    "@nestjs/platform-fastify": "latest",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "bcrypt": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "fastify": "latest",
    "nodemailer": "9.0.4",
    "passport": "latest",
    "passport-jwt": "latest",
    "pdfkit": "^0.19.1",
    "pg": "latest",
    "redis": "5.8.2",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@nestjs/mapped-types": "latest",
    "@nestjs/testing": "latest",
    "@redocly/cli": "2.45.0",
    "@types/bcrypt": "latest",
    "@types/jest": "30.0.0",
    "@types/node": "latest",
    "@types/nodemailer": "8.0.1",
    "@types/passport-jwt": "latest",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "latest",
    "@types/supertest": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "drizzle-kit": "latest",
    "eslint": "latest",
    "jest": "latest",
    "prettier": "^3.0.0",
    "supertest": "latest",
    "ts-jest": "latest",
    "ts-node": "latest",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.5": "3.1.5",
      "fast-uri@>=4.0.0 <4.1.2": "4.1.2",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "find-my-way@<9.7.0": "9.7.0",
      "js-yaml@>=5.0.0 <5.2.2": "5.2.2"
    }
  }
}
