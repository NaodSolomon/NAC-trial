# Copy to frontend/.env.production. Compose enforces these public origins from the root
# .env.production file; keep this template for non-Compose production builds.
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api.example.org/api/v1
NEXT_PUBLIC_SITE_URL=https://www.example.org
NEXT_PUBLIC_STORAGE_ORIGIN=https://media.example.org
NEXT_PUBLIC_MEDIA_HOSTS=https://media.example.org
MEDIA_IMAGE_ORIGIN=https://media.example.org
API_URL=https://api.example.org/api/v1
REFRESH_COOKIE_MAX_AGE_SECONDS=604800
