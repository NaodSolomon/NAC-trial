{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/start-lighthouse-environment.mjs",
      "startServerReadyPattern": "LIGHTHOUSE_ENVIRONMENT_READY",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://localhost:3000/?lang=en",
        "http://localhost:3000/about?lang=en",
        "http://localhost:3000/blog?lang=en",
        "http://localhost:3000/events?lang=en"
      ],
      "numberOfRuns": 3,
      "settings": {
        "budgetsPath": "./lighthouse-budget.json",
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "uses-responsive-images": "error",
        "uses-optimized-images": "error"
      }
    }
  }
}
